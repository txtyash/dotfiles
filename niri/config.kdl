// RTFM: https://niri-wm.github.io/niri/Configuration%3A-Introduction.html

hotkey-overlay {
    skip-at-startup
}

// spawn-at-startup "protonvpn" "connect" "--country" "US"
spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"

cursor {
    xcursor-theme "GoogleDot-Blue"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 1000
}

input {
    touchpad {
        tap
        natural-scroll
        accel-speed 0.84
        scroll-factor 0.39
    }
}

gestures {
    hot-corners {
        off
    }
}

output "eDP-1" {
    mode "1920x1200@60.003"
    scale 1
}

layout {
    focus-ring {
    	width 6
    }
    border {
	off
	width 6
    }
    background-color "transparent"
}

blur {
    on
    passes 3
    noise 0.05
}

screenshot-path "~/Pictures/Screenshots/%Y%m%d_%H%M%S.png"

window-rule {
    match app-id=r#"helium$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    clip-to-geometry true
}

window-rule {
    match is-active=true
    opacity 0.95
}

window-rule {
    match is-active=false
    opacity 0.85
}

binds {
    Mod+Alt+Shift+Slash { show-hotkey-overlay; }
    Mod+Alt+T hotkey-overlay-title="Open a Terminal: Ghostty" { spawn "ghostty"; }
    Mod+Alt+B hotkey-overlay-title="Open a Browser: Helium" { spawn "helium"; }
    Mod+Alt+G { spawn-sh "niri msg outputs | grep -q '180°' && niri msg output eDP-1 transform normal || niri msg output eDP-1 transform 180"; }
    Mod+Alt+N { spawn-sh "dms ipc notepad toggle"; }
    Mod+Alt+P { spawn-sh "dms ipc mpris playPause"; }
    Mod+Alt+E { spawn-sh "dms ipc spotlight toggle"; }
    Mod+Alt+D { spawn-sh "dms ipc theme toggle"; }
    Mod+Alt+Space { spawn-sh "dms ipc clipboard toggle"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "dms ipc audio increment 3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "dms ipc audio decrement 3"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "dms ipc audio mute"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "dms ipc mpris playPause"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "dms ipc mpris playPause"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "dms ipc mpris next"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "dms ipc mpris previous"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "dms ipc call brightness increment 1 backlight:intel_backlight"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "dms ipc call brightness decrement 1 backlight:intel_backlight"; }
    Mod+Alt+O repeat=false { toggle-overview; }
    Mod+Alt+Q repeat=false { close-window; }
    Mod+Alt+Left  { focus-column-left; }
    Mod+Alt+Down  { focus-window-down; }
    Mod+Alt+Up    { focus-window-up; }
    Mod+Alt+Right { focus-column-right; }
    Mod+Alt+H     { focus-column-left; }
    Mod+Alt+J     { focus-window-down; }
    Mod+Alt+K     { focus-window-up; }
    Mod+Alt+L     { focus-column-right; }
    Mod+Alt+Ctrl+Left  { move-column-left; }
    Mod+Alt+Ctrl+Down  { move-window-down; }
    Mod+Alt+Ctrl+Up    { move-window-up; }
    Mod+Alt+Ctrl+Right { move-column-right; }
    Mod+Alt+Ctrl+H     { move-column-left; }
    Mod+Alt+Ctrl+J     { move-window-down; }
    Mod+Alt+Ctrl+K     { move-window-up; }
    Mod+Alt+Ctrl+L     { move-column-right; }
    Mod+Alt+Home { focus-column-first; }
    Mod+Alt+End  { focus-column-last; }
    Mod+Alt+Ctrl+Home { move-column-to-first; }
    Mod+Alt+Ctrl+End  { move-column-to-last; }
    Mod+Alt+Shift+Left  { focus-monitor-left; }
    Mod+Alt+Shift+Down  { focus-monitor-down; }
    Mod+Alt+Shift+Up    { focus-monitor-up; }
    Mod+Alt+Shift+Right { focus-monitor-right; }
    Mod+Alt+Shift+H     { focus-monitor-left; }
    Mod+Alt+Shift+J     { focus-monitor-down; }
    Mod+Alt+Shift+K     { focus-monitor-up; }
    Mod+Alt+Shift+L     { focus-monitor-right; }
    Mod+Alt+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Alt+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Alt+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Alt+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Alt+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Alt+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Alt+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Alt+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+Alt+Page_Down      { focus-workspace-down; }
    Mod+Alt+Page_Up        { focus-workspace-up; }
    Mod+Alt+U              { focus-workspace-down; }
    Mod+Alt+I              { focus-workspace-up; }
    Mod+Alt+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Alt+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Alt+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Alt+Ctrl+I         { move-column-to-workspace-up; }
    Mod+Alt+Shift+Page_Down { move-workspace-down; }
    Mod+Alt+Shift+Page_Up   { move-workspace-up; }
    Mod+Alt+Shift+U         { move-workspace-down; }
    Mod+Alt+Shift+I         { move-workspace-up; }
    Mod+Alt+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+Alt+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Alt+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Alt+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Alt+WheelScrollRight      { focus-column-right; }
    Mod+Alt+WheelScrollLeft       { focus-column-left; }
    Mod+Alt+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Alt+Ctrl+WheelScrollLeft  { move-column-left; }
    Mod+Alt+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Alt+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Alt+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Alt+Ctrl+Shift+WheelScrollUp   { move-column-left; }
    Mod+Alt+1 { focus-workspace 1; }
    Mod+Alt+2 { focus-workspace 2; }
    Mod+Alt+3 { focus-workspace 3; }
    Mod+Alt+4 { focus-workspace 4; }
    Mod+Alt+5 { focus-workspace 5; }
    Mod+Alt+6 { focus-workspace 6; }
    Mod+Alt+7 { focus-workspace 7; }
    Mod+Alt+8 { focus-workspace 8; }
    Mod+Alt+9 { focus-workspace 9; }
    Mod+Alt+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Alt+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Alt+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Alt+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Alt+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Alt+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Alt+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Alt+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Alt+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Alt+BracketLeft  { consume-or-expel-window-left; }
    Mod+Alt+BracketRight { consume-or-expel-window-right; }
    Mod+Alt+Comma  { consume-window-into-column; }
    Mod+Alt+Period { expel-window-from-column; }
    Mod+Alt+R { switch-preset-column-width; }
    Mod+Alt+Shift+R { switch-preset-window-height; }
    Mod+Alt+Ctrl+R { reset-window-height; }
    Mod+Alt+F { maximize-column; }
    Mod+Alt+Shift+F { fullscreen-window; }
    Mod+Alt+Ctrl+F { expand-column-to-available-width; }
    Mod+Alt+C { center-column; }
    Mod+Alt+Ctrl+C { center-visible-columns; }
    Mod+Alt+Minus { set-column-width "-10%"; }
    Mod+Alt+Equal { set-column-width "+10%"; }
    Mod+Alt+Shift+Minus { set-window-height "-10%"; }
    Mod+Alt+Shift+Equal { set-window-height "+10%"; }
    Mod+Alt+V       { toggle-window-floating; }
    Mod+Alt+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+Alt+W { toggle-column-tabbed-display; }
    Print { spawn-sh "dms screenshot"; }
    Mod+Alt+Print { screenshot-window; }
    Mod+Alt+Ctrl+Print { screenshot-screen; }
    Mod+Alt+Shift+Print { screenshot-screen; }
    Mod+Alt+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Alt+Shift+Q { quit; }
    Mod+Alt+Shift+P { power-off-monitors; }
}

debug {
  honor-xdg-activation-with-invalid-serial
}
overview {
  backdrop-color "transparent"
  workspace-shadow {
    off
  }
}

layer-rule {
    exclude namespace="^dms:"
    place-within-backdrop true
}

include "dms/colors.kdl"
include "dms/layout.kdl"
include "dms/alttab.kdl"
include "dms/binds.kdl"

include "dms/cursor.kdl"
